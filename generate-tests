#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'
require 'resolv'
require 'socket'
require 'fileutils'
require 'yaml'
require 'optparse'

# Monkey-patch: map dashed switch names (e.g. --do-something) to underscored keys
# (do_something) so OptionParser#parse!(into: Struct) can assign them directly.
module OptparseDashToUnderscore
	def switch_name
		super.tr('-', '_')
	end
end
OptionParser::Switch.prepend(OptparseDashToUnderscore)

# {{{ Options
Options = Struct.new(:regenerate, :config, :list_tests)
options = Options.new
options.regenerate = false
options.config = false
options.list_tests = false

optparse = OptionParser.new { |opts|
	opts.banner = "Usage: #{File.basename($PROGRAM_NAME)} <dir> [test-id] [options]"
	opts.separator 'Options:'
	opts.on('--[no-]regenerate', 'Regenerate EML even if it already exists')
	opts.on('--config', '(Re-)configure: ask questions (existing values as defaults), validate DNS, save config')
	opts.on('--list-tests', 'List all tests with description (no dir required)')
	opts.on('-h', '--help', 'show this message') {
		puts opts
		exit
	}
}

begin
	optparse.parse!(into: options)
rescue StandardError => e
	puts optparse
	raise e
end

if ARGV.length > 2 || (!options.list_tests && ARGV.empty?)
	puts optparse
	exit
end

dir        = ARGV[0]
test_id    = ARGV[1]
config_file = dir && "#{dir}/config.yml"
# }}}

def ask(prompt, default = nil)
	loop {
		print default ? "#{prompt} [#{default}]: " : "#{prompt}: "
		input = ($stdin.gets || '').chomp
		result = input.empty? ? default : input
		return result if result && !result.empty?

		puts '  (required)'
	}
end

def org_domain(domain)
	domain.split('.').last(2).join('.')
end

def dig_txt(name)
	out, = Open3.capture2('dig', '+short', 'txt', name, err: File::NULL)
	out.strip
end

def check_dns(spf_pass, spf_hardfail, dmarc_reject, dkim_domain, dkim_selector)
	errors = []

	spf_pass_record = dig_txt(spf_pass)
	if !spf_pass_record.include?('v=spf1')
		errors << "#{spf_pass}: no SPF record found"
	elsif !spf_pass_record.include?('+all')
		errors << "#{spf_pass}: SPF record has no '+all' — cannot guarantee pass for arbitrary IPs: #{spf_pass_record}"
	end

	spf_hardfail_record = dig_txt(spf_hardfail)
	if !spf_hardfail_record.include?('v=spf1')
		errors << "#{spf_hardfail}: no SPF record found"
	elsif !spf_hardfail_record.include?('-all')
		errors << "#{spf_hardfail}: SPF record has no '-all': #{spf_hardfail_record}"
	end

	dmarc_record = dig_txt("_dmarc.#{dmarc_reject}")
	if dmarc_record.empty?
		errors << "_dmarc.#{dmarc_reject}: no DMARC record found"
	elsif !dmarc_record.include?('p=reject')
		errors << "_dmarc.#{dmarc_reject}: DMARC record has no 'p=reject': #{dmarc_record}"
	elsif !dmarc_record.include?('adkim=s')
		errors << "_dmarc.#{dmarc_reject}: no 'adkim=s' — DKIM strict alignment test will not work: #{dmarc_record}"
	end

	rsa_record = dig_txt('rsa-2026._domainkey.mgm-sp.team')
	errors << 'rsa-2026._domainkey.mgm-sp.team: no DKIM key found (needed for valid DKIM tests)' if rsa_record.empty?

	ed_record = dig_txt('ed25519-2026._domainkey.mgm-sp.team')
	errors << 'ed25519-2026._domainkey.mgm-sp.team: no DKIM key found (needed for valid DKIM tests)' if ed_record.empty?

	dkim_record = dig_txt("#{dkim_selector}._domainkey.#{dkim_domain}")
	if dkim_record.empty?
		errors << "#{dkim_selector}._domainkey.#{dkim_domain}: no DKIM key found (needed for invalid DKIM test)"
	end

	if (org_domain(spf_pass) == org_domain(dmarc_reject)) && !dmarc_record.include?('aspf=s')
		errors << "SPF-pass domain (#{spf_pass}) and DMARC-reject domain (#{dmarc_reject}) share " \
			"the same organizational domain '#{org_domain(dmarc_reject)}'. " \
			'With relaxed alignment (default), SPF will align and DMARC will pass. ' \
			"Fix: use a SPF-pass domain from a different org domain, or add aspf=s to _dmarc.#{dmarc_reject}"
	end

	errors
end

def generate_test_eml(test, rcpt, target, domain_subs)
	args = ['./preprocess', '--eval-cmd', 'dig']
	args << '--force' if test[:force]
	domain_subs.each { |k, v| args += ['--replace', "#{k}=#{v}"] }
	# DKIM-signed templates must have swaks tokens resolved before signing,
	# otherwise swaks would later substitute them and break the body hash.
	# Templates with real DKIM signing carry the "b=FIXME" marker.
	if File.read(test[:template]).include?('b=FIXME')
		now = Time.now
		{
			'FROM_ADDRESS' => test[:from],
			'TO_ADDRESS'   => rcpt,
			'DATE'         => now.strftime('%a, %d %b %Y %T %z'),
			'MESSAGEID'    => "#{now.utc.strftime('%Y%m%d%H%M%S%N')}@#{Socket.gethostname}"
		}.each { |k, v| args += ['--replace', "#{k}=#{v}"] }
	end
	args += [test[:template], target]
	unless system(*args)
		warn "  preprocess failed for #{test[:id]} (exit #{$?.exitstatus})"
		return
	end
	puts "  written: #{target}"
end

def build_tests(helo, spf_pass, spf_hardfail, dmarc_reject)
	[
		{
			id: 'baseline',
			comment: 'Check if mail works (+IP reverse lookup, +IP blacklist)',
			from: "someone@#{helo}",
			template: 'examples/valid.eml'
		},
		{
			id: 'spf-pass',
			comment: 'Check if SPF pass is recognized',
			from: "someone@#{spf_pass}",
			template: 'examples/spf-pass.eml'
		},
		{
			id: 'spf-hardfail',
			comment: 'Check if SPF hardfail (-all) is rejected',
			from: "someone@#{spf_hardfail}",
			template: 'examples/spf-hardfail.eml'
		},
		{
			id: 'invalid-from',
			comment: 'Check if From-Address can be bullshit',
			from: "someone@#{helo}",
			template: 'examples/invalid-from.eml'
		},
		{
			id: 'dmarc-noalign',
			comment: 'Check if DMARC reject is checked (no DKIM, MAIL FROM not aligned)',
			from: "someone@#{helo}",
			template: 'examples/dmarc-reject.eml'
		},
		{
			id: 'dkim-invalid',
			comment: 'Check if invalid DKIM is rejected',
			from: "someone@#{helo}",
			template: 'examples/dkim-reject.eml',
			force: true
		},
		{
			id: 'spf-pass-dkim-fail',
			comment: 'Check if SPF pass without alignment and invalid DKIM triggers DMARC reject',
			from: "someone@#{spf_pass}",
			template: 'examples/spf-pass-dkim-fail.eml',
			force: true
		},
		{
			id: 'spf-pass-no-dkim',
			comment: 'Check if SPF pass without alignment and missing DKIM triggers DMARC reject',
			from: "someone@#{spf_pass}",
			template: 'examples/dmarc-reject.eml'
		},
		{
			id: 'dkim-dual',
			comment: 'Check if valid DKIM (rsa-sha256 + ed25519-sha256) is accepted',
			from: 'someone@mgm-sp.team',
			template: 'examples/dkim-valid.eml'
		},
		{
			id: 'dkim-rsa',
			comment: 'Check if valid DKIM (rsa-sha256 only) is accepted',
			from: 'someone@mgm-sp.team',
			template: 'examples/dkim-rsa.eml'
		},
		{
			id: 'dkim-ed25519',
			comment: 'Check if valid DKIM (ed25519-sha256 only) is accepted',
			from: 'someone@mgm-sp.team',
			template: 'examples/dkim-ed25519.eml'
		},
		{
			id: 'dkim-rsa-sha1',
			comment: 'Check if DKIM with rsa-sha1 is rejected (RFC 8301)',
			from: 'someone@mgm-sp.team',
			template: 'examples/dkim-rsa-sha1.eml'
		},
		{
			id: 'dmarc-strict-align',
			comment: 'Check if valid DKIM with strict DMARC alignment failure (adkim=s, subdomain) is rejected',
			from: "someone@#{dmarc_reject}",
			template: 'examples/dkim-dmarc-strict-fail.eml'
		},
		{
			id: 'dkim-oversign',
			comment: 'Check if valid oversigned DKIM is accepted',
			from: 'someone@mgm-sp.team',
			template: 'examples/dkim-oversign.eml'
		},
		{
			id: 'dkim-from-inject',
			comment: 'Check if From-header injection (non-oversigned, valid DKIM) is detected',
			from: 'someone@mgm-sp.team',
			template: 'examples/dkim-from-injection.eml'
		},
		{
			id: 'eicar',
			comment: 'Check if recipient has a virus scanner in place',
			from: "someone@#{helo}",
			template: 'examples/eicar.eml'
		}
	]
end

def build_domain_subs(spf_pass, dmarc_reject, dkim_domain)
	{
		'DMARC-REJECT-DOMAIN' => dmarc_reject,
		'SPF-PASS-DOMAIN' => spf_pass,
		'DMARC-NONE-DOMAIN' => dkim_domain,
		'DKIM-DOMAIN' => dkim_domain
	}
end

def load_config(path)
	YAML.load_file(path, symbolize_names: true)
end

def save_config(path, data)
	File.write(path, data.to_yaml)
end

def show_help(tests, dir)
	script = File.basename($PROGRAM_NAME)
	puts "Available tests (#{dir}):"
	puts
	tests.each { |t|
		eml    = "#{dir}/#{t[:id]}.eml"
		status = File.exist?(eml) ? '✓' : '✗'
		puts "  #{status} #{t[:id].ljust(20)} #{t[:comment]}"
	}
	puts
	puts "Generate a single test:  #{script} #{dir} <test-id>"
	puts "Force regeneration:      #{script} #{dir} <test-id> --regenerate"
	puts "Re-configure:            #{script} #{dir} --config"
end

# {{{ Config flow
def run_config(dir, config_file)
	FileUtils.mkdir_p(dir)
	existing = File.exist?(config_file) ? load_config(config_file) : {}

	default_helo = begin
		ip = UDPSocket.new.tap { |s| s.connect('1.1.1.1', 80) }.addr[3]
		Resolv.getname(ip).chomp('.')
	rescue StandardError
		nil
	end || Socket.gethostname

	rcpt         = ask('Enter a recipient address on the tested server', existing[:rcpt])
	helo         = ask('HELO/EHLO hostname', existing[:helo] || default_helo)
	spf_pass     = ask('Domain with SPF pass     (v=spf1 +all or IP listed)', existing[:spf_pass] || 'pass.mail.mgm-sp.team')
	spf_hardfail = ask('Domain with SPF hardfail (v=spf1 -all)',              existing[:spf_hardfail] || 'hardfail.mail.mgm-sp.team')
	dmarc_reject = ask('Domain with DMARC reject (TXT: "v=DMARC1; p=reject; aspf=s; adkim=s;")', existing[:dmarc_reject] || 'reject.mail.mgm-sp.team')
	puts <<~HINT
	 Hint: The DKIM domain needs a TXT record at <selector>._domainkey.<domain>
	 with a public key that does NOT match the private key used in the test EML.
	 Generate one with:
	   openssl genrsa 2048 | openssl rsa -pubout -outform DER | openssl base64 -A
	 Then set the DNS record:
	   <selector>._domainkey.<domain>  TXT  "v=DKIM1; k=rsa; p=<generated-key>"
	HINT
	dkim_domain   = ask('Domain with invalid DKIM key configured', existing[:dkim_domain] || 'mgm-sp.team')
	dkim_selector = ask('Selector for invalid DKIM key', existing[:dkim_selector] || 'random-rsa')

	# --- DNS Validation ---
	puts "\nChecking DNS records..."
	errors = check_dns(spf_pass, spf_hardfail, dmarc_reject, dkim_domain, dkim_selector)
	if errors.any?
		puts '  DNS validation failed:'
		errors.each { |e| puts "  ✗ #{e}" }
		exit 1
	else
		puts '  ✓ all records OK'
	end

	save_config(config_file, {
		'rcpt' => rcpt,
		'helo' => helo,
		'spf_pass' => spf_pass,
		'spf_hardfail' => spf_hardfail,
		'dmarc_reject' => dmarc_reject,
		'dkim_domain' => dkim_domain,
		'dkim_selector' => dkim_selector
	})
	puts "  Config saved to #{config_file}"
end
# }}}

if options.list_tests
	tests = build_tests('HELO', 'SPF-PASS', 'SPF-HARDFAIL', 'DMARC-REJECT')
	width = tests.map { |t| t[:id].length }.max
	tests.each { |t| puts "#{t[:id].ljust(width + 2)}#{t[:comment]}" }
	exit
end

# {{{ Main
run_config(dir, config_file) if !File.exist?(config_file) || options.config

cfg          = load_config(config_file)
rcpt         = cfg[:rcpt]
helo         = cfg[:helo]
spf_pass     = cfg[:spf_pass]
spf_hardfail = cfg[:spf_hardfail]
dmarc_reject = cfg[:dmarc_reject]
dkim_domain  = cfg[:dkim_domain]

tests = build_tests(helo, spf_pass, spf_hardfail, dmarc_reject)

if test_id
	t = tests.find { |x| x[:id] == test_id }
	abort "Unknown test: #{test_id}\nRun '#{File.basename($PROGRAM_NAME)} #{dir}' for available tests." unless t

	eml = "#{dir}/#{t[:id]}.eml"
	if File.exist?(eml) && !options.regenerate
		warn "  Warning: #{eml} already exists. Use --regenerate to overwrite."
	else
		generate_test_eml(t, rcpt, eml, build_domain_subs(spf_pass, dmarc_reject, dkim_domain))
	end
	if File.exist?(eml)
		if File.read(eml).end_with?("\r\n")
			warn "  Warning: #{eml} ends with CRLF — swaks will add an extra blank line before the DATA terminator."
			warn "    Strip it with: truncate -s -2 #{eml}"
		end
		puts "swaks --from #{t[:from]} --to #{rcpt} --data @#{eml}"
	end
else
	show_help(tests, dir)
end
# }}}
