def ask(prompt, default = nil)
	loop {
		print default ? "#{prompt} [#{default}]: " : "#{prompt}: "
		input = ($stdin.gets || '').chomp
		result = input.empty? ? default : input
		return result if result && !result.empty?

		puts '  (required)'
	}
end

def org_domain(domain)
	domain.split('.').last(2).join('.')
end

def dig_txt(name)
	out, = Open3.capture2('dig', '+short', 'txt', name, err: File::NULL)
	out.strip
end

def check_spf(domain, qualifier, label)
	record = dig_txt(domain)
	return ["#{domain}: no SPF record found"] unless record.include?('v=spf1')
	return ["#{domain}: SPF record has no '#{qualifier}all' (#{label}): #{record}"] unless record.include?("#{qualifier}all")

	[]
end

def outgoing_public_ip
	UDPSocket.new.tap { |s| s.connect('1.1.1.1', 80) }.addr[3]
rescue StandardError
	nil
end

# End-to-end DKIM validation: build a minimal signed EML for (selector, domain,
# algo), sign via preprocess (which uses <selector>.key from the script dir),
# then verify with dkimverify (dkimpy). This catches both missing/mismatched
# DNS keys and signing-logic regressions.
# Returns nil on success, an error string on failure, or :skipped if
# dkimverify is not installed.
def validate_dkim_key(selector, domain, algo)
	script_dir = File.dirname(File.realpath($PROGRAM_NAME))
	eml = +"From: test@example.com\r\n" \
		"To: test@example.com\r\n" \
		"Subject: dkim-check\r\n" \
		"DKIM-Signature: v=1; a=#{algo}; q=dns/txt; c=relaxed/relaxed;\r\n" \
		" s=#{selector}; d=#{domain};\r\n" \
		" h=From:To:Subject;\r\n" \
		" bh=FIXME;\r\n" \
		" b=FIXME;\r\n" \
		"\r\n" \
		"test\r\n"
	Tempfile.create('dkim-check') { |f|
		f.write(eml)
		f.close
		signed, sign_err, sign_status = Open3.capture3(File.join(script_dir, 'preprocess'), f.path)
		return "preprocess failed: #{sign_err.strip}" unless sign_status.success?

		out, _err, _status = Open3.capture3('dkimverify', stdin_data: signed)
		return nil if out.include?('signature ok')

		out.strip.empty? ? 'dkimverify: no output' : "dkimverify: #{out.strip}"
	}
rescue Errno::ENOENT
	:skipped
end

# Run spfquery for full RFC 7208 evaluation. Returns the result string:
# pass / fail / softfail / neutral / none / permerror / temperror,
# or nil if spfquery is not installed.
# Uses long options with '=' for portability across spfquery.libspf2 and
# spfquery.pyspf (both reachable via /usr/bin/spfquery alternatives).
def spfquery_result(domain, ip)
	out, _err, _status = Open3.capture3('spfquery', "--ip=#{ip}", "--sender=test@#{domain}")
	out.lines.first&.strip
rescue Errno::ENOENT
	nil
end

def check_dns(cfg)
	errors = []

	errors += check_spf(cfg['spf_pass'],     '+', 'pass')
	errors += check_spf(cfg['spf_hardfail'], '-', 'hardfail')
	errors += check_spf(cfg['spf_neutral'],  '?', 'neutral')
	errors += check_spf(cfg['spf_softfail'], '~', 'softfail')

	dmarc_quarantine_record = dig_txt("_dmarc.#{cfg['dmarc_quarantine']}")
	if dmarc_quarantine_record.empty?
		errors << "_dmarc.#{cfg['dmarc_quarantine']}: no DMARC record found"
	elsif !dmarc_quarantine_record.include?('p=quarantine')
		errors << "_dmarc.#{cfg['dmarc_quarantine']}: DMARC record has no 'p=quarantine': #{dmarc_quarantine_record}"
	end

	dmarc_record = dig_txt("_dmarc.#{cfg['dmarc_reject']}")
	if dmarc_record.empty?
		errors << "_dmarc.#{cfg['dmarc_reject']}: no DMARC record found"
	else
		errors << "_dmarc.#{cfg['dmarc_reject']}: DMARC record has no 'p=reject': #{dmarc_record}" unless dmarc_record.include?('p=reject')
		errors << "_dmarc.#{cfg['dmarc_reject']}: no 'adkim=s' — DKIM strict alignment test will not work: #{dmarc_record}" unless dmarc_record.include?('adkim=s')
		errors << "_dmarc.#{cfg['dmarc_reject']}: no 'aspf=s' — SPF strict alignment cannot be enforced: #{dmarc_record}" unless dmarc_record.include?('aspf=s')
	end

	# Valid-DKIM keys: signed EMLs use d=cfg['dmarc_reject'] (via %VALID-DKIM-DOMAIN%).
	# dmarc-strict-align uses d=cfg['dkim_domain'] (parent org).
	# For each (selector, domain, algo), do an end-to-end sign+verify to catch
	# both missing DNS records and public/private-key mismatches.
	dkim_targets = [
		['rsa-2026',     cfg['dmarc_reject'], 'rsa-sha256',     'valid DKIM tests'],
		['ed25519-2026', cfg['dmarc_reject'], 'ed25519-sha256', 'valid DKIM tests'],
		['rsa-2026',     cfg['dkim_domain'],  'rsa-sha256',     'dmarc-strict-align test'],
		['ed25519-2026', cfg['dkim_domain'],  'ed25519-sha256', 'dmarc-strict-align test']
	]
	skipped = false
	dkim_targets.each { |selector, domain, algo, purpose|
		result = validate_dkim_key(selector, domain, algo)
		case result
		when nil
			# ok
		when :skipped
			skipped = true
		else
			errors << "#{selector}._domainkey.#{domain}: #{result} (needed for #{purpose})"
		end
	}
	warn "  ! 'dkimverify' not installed, skipping DKIM key validation. Install python3-dkim or pipx install dkimpy." if skipped

	dkim_record = dig_txt("#{cfg['dkim_selector']}._domainkey.#{cfg['dkim_domain']}")
	if dkim_record.empty?
		errors << "#{cfg['dkim_selector']}._domainkey.#{cfg['dkim_domain']}: no DKIM key found (needed for invalid DKIM test)"
	end

	# foreign_spf_pass: envelope MAIL FROM for valid-DKIM tests. Must be a domain
	# whose SPF authorizes the sender IP, from a different org than cfg['dmarc_reject']
	# (so relaxed alignment cannot short-circuit DMARC via SPF).
	fsp = cfg['foreign_spf_pass']
	fsp_record = dig_txt(fsp)
	if fsp_record.empty? || !fsp_record.include?('v=spf1')
		errors << "#{fsp}: no SPF record found (foreign_spf_pass needs v=spf1)"
	elsif org_domain(fsp) == org_domain(cfg['dmarc_reject'])
		errors << "foreign_spf_pass (#{fsp}) shares org domain with dmarc_reject (#{cfg['dmarc_reject']}) -- " \
			'SPF would still align via relaxed alignment. Pick a domain from a different org.'
	else
		ip = outgoing_public_ip
		if ip.nil?
			errors << 'could not determine outgoing public IP (needed to validate foreign_spf_pass SPF)'
		else
			result = spfquery_result(fsp, ip)
			case result
			when nil
				warn "  ! 'spfquery' not installed, skipping SPF IP check for #{fsp}. Install libmail-spf-perl, libspf2-bin, or python3-spf. Record: #{fsp_record}"
			when 'pass'
				# ok
			else
				errors << "#{fsp}: SPF result '#{result}' for sender IP #{ip}. Record: #{fsp_record}. " \
					'Fix: adjust SPF to include this IP, or run tests from an authorized host.'
			end
		end
	end

	errors
end

def generate_test_eml(test, rcpt, target, domain_subs)
	args = ['./preprocess', '--eval-cmd', 'dig']
	args << '--force' if test[:force]
	domain_subs.each { |k, v| args += ['--replace', "#{k}=#{v}"] }
	# DKIM-signed templates must have swaks tokens resolved before signing,
	# otherwise swaks would later substitute them and break the body hash.
	# Templates with real DKIM signing carry the "b=FIXME" marker.
	if File.read(test[:template]).include?('b=FIXME')
		now = Time.now
		{
			'FROM_ADDRESS' => test[:from],
			'TO_ADDRESS'   => rcpt,
			'DATE'         => now.strftime('%a, %d %b %Y %T %z'),
			'MESSAGEID'    => "#{now.utc.strftime('%Y%m%d%H%M%S%N')}@#{Socket.gethostname}"
		}.each { |k, v| args += ['--replace', "#{k}=#{v}"] }
	end
	args += [test[:template], target]
	unless system(*args)
		warn "  preprocess failed for #{test[:id]} (exit #{$?.exitstatus})"
		return
	end
	puts "  written: #{target}"
end

