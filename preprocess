#!/usr/bin/env ruby
# frozen_string_literal: true

# {{{ Options
require 'base64'
require 'openssl'
require 'optparse'
require 'socket'

Options = Struct.new(:replace, :dkim_key, :force, :eval_cmds)
options = Options.new
options.replace   = {}
options.dkim_key  = {}
options.force     = false
options.eval_cmds = []

optparse = OptionParser.new { |opts|
	opts.banner = "Usage: #{File.basename($PROGRAM_NAME)} [options] <input.eml> [output.eml]"
	opts.separator 'Options:'

	opts.on('--replace KEY=VALUE', 'Replace INSERT-KEY-VARIABLE with VALUE (repeatable)') { |kv|
		k, v = kv.split('=', 2)
		options.replace[k.upcase] = v
	}
	opts.on('--dkim-key TYPE=FILE', 'Key file override for algorithm family: rsa or ed25519 (repeatable)') { |kv|
		type, file = kv.split('=', 2)
		options.dkim_key[type] = file
	}
	opts.on('--force', 'Treat DKIM errors and unresolved placeholders as warnings instead of aborting') {
		options.force = true
	}
	opts.on('--eval-cmd CMD',
		'Re-execute "$ CMD ..." lines in body, replacing output until next blank line (repeatable)') { |cmd|
		options.eval_cmds << cmd
	}

	opts.on('-h', '--help', 'show this message') {
		puts opts
		exit
	}
}

begin
	optparse.parse!
rescue StandardError => e
	puts optparse
	raise e
end

unless ARGV[0]
	puts optparse
	exit 1
end

input_file  = ARGV[0]
output_file = ARGV[1]
# }}}

SCRIPT_DIR = File.dirname(File.realpath($PROGRAM_NAME))

# {{{ Variable substitution
content = File.read(input_file)

current_time = Time.now
replace = {
	'DATE' => current_time.strftime('%a, %d %b %Y %T %z'),
	'MESSAGEID' => "#{current_time.utc.strftime('%Y%m%d%H%M%S%N')}@#{Socket.gethostname}"
}
replace.merge!(options.replace)
replace.each { |k, v| content.gsub!("INSERT-#{k}-VARIABLE", v) }
# }}}

# {{{ Command evaluation
options.eval_cmds.each { |cmd|
	content.gsub!(/^(\$ #{Regexp.escape(cmd)} [^\r\n]+)(\r?\n)((?:[^\r\n]+\r?\n)*)/) {
		cmd_text   = Regexp.last_match(1)
		eol        = Regexp.last_match(2)
		old_output = Regexp.last_match(3)
		full_cmd   = cmd_text.sub(/^\$ /, '')
		begin
			new_output = IO.popen(full_cmd.split, 'r', err: %i[child out], &:read).chomp
			new_output.empty? ? "#{cmd_text}#{eol}" : "#{cmd_text}#{eol}#{new_output}#{eol}"
		rescue StandardError => e
			msg = "preprocess: eval-cmd failed (#{full_cmd}): #{e.message}"
			options.force ? warn(msg) : abort(msg)
			"#{cmd_text}#{eol}#{old_output}"
		end
	}
}
# }}}

# {{{ DKIM signing
# RFC 5322: mails use CRLF line endings. parse_email assumes CRLF input and
# preserves it in header values (folded continuations) and the body.
def parse_email(text)
	sep       = text.index("\r\n\r\n")
	head_text = sep ? text[0...sep] : text
	body      = sep ? text[(sep + 4)..] : ''

	headers = []
	head_text.split("\r\n").each { |line|
		if line =~ /\A[ \t]/ && headers.any?
			headers.last[1] += "\r\n#{line}"
		elsif (m = line.match(/\A([^:]+):(.*)\z/m))
			headers << [m[1], m[2]]
		end
	}
	[headers, body]
end

def relaxed_header(name, value)
	value = value.gsub(/\r?\n[ \t]+/, ' ').gsub(/[ \t]+/, ' ').strip
	"#{name.downcase}:#{value}"
end

def relaxed_body(body)
	lines = body.split(/\r?\n/, -1).map { |l| l.gsub(/[ \t]+/, ' ').rstrip }
	lines.pop while lines.last == ''
	lines.empty? ? "\r\n" : "#{lines.join("\r\n")}\r\n"
end

def dkim_tag(value, tag)
	m = value.match(/(?:^|;)\s*#{Regexp.escape(tag)}=([^;]*)/)
	m&.then { |match| match[1].strip }
end

def algo_family(algo)
	case algo
	when /\Arsa-/ then 'rsa'
	when /\Aed25519-/ then 'ed25519'
	end
end

def fold_b64(b64, width: 72)
	first_max = width - 3  # ' b=' prefix in template continuation line
	rest_max  = width - 1  # ' ' continuation indent for subsequent lines
	parts = ["b=#{b64[0, first_max]}"]
	pos = first_max
	while pos < b64.length
		parts << b64[pos, rest_max]
		pos += rest_max
	end
	parts.join("\r\n ")
end

def sign_dkim(content, dkim_key_overrides, force: false)
	headers, body = parse_email(content)

	return content if headers.none? { |h| h[0].downcase == 'dkim-signature' }

	relaxed = relaxed_body(body)
	body_hash = {
		'sha256' => Base64.strict_encode64(OpenSSL::Digest::SHA256.digest(relaxed)),
		'sha1' => Base64.strict_encode64(OpenSSL::Digest::SHA1.digest(relaxed))
	}

	headers.each { |name, value|
		next unless name.downcase == 'dkim-signature'

		algo     = dkim_tag(value, 'a')
		selector = dkim_tag(value, 's')
		family   = algo_family(algo)
		hash_alg = algo.split('-', 2).last

		key_file = dkim_key_overrides[family] || File.join(SCRIPT_DIR, "#{selector}.key")
		unless File.exist?(key_file)
			if force
				warn "preprocess: warning: key not found for algorithm #{algo} (selector #{selector}): #{key_file} -- skipping"
				next
			else
				abort "preprocess: key not found for algorithm #{algo} (selector #{selector}): #{key_file}"
			end
		end

		bh = body_hash.fetch(hash_alg) { abort "preprocess: unknown hash algorithm: #{hash_alg}" }
		value.gsub!(/\bbh=[^;]*/, "bh=#{bh}")

		header_list = dkim_tag(value, 'h').to_s.split(':').map(&:strip)
		available = headers.dup
		signing_parts = header_list.filter_map { |h|
			idx = available.rindex { |hdr| hdr[0].downcase == h.downcase }
			relaxed_header(*available.delete_at(idx)) if idx
		}
		unfolded = value.gsub(/\r?\n[ \t]+/, ' ')
		signing_parts << relaxed_header(name, unfolded.sub(/; b=[^;]*/, '; b='))
		signing_data = signing_parts.join("\r\n")

		key_pem = File.read(key_file)
		case algo
		when 'rsa-sha1'
			sig = OpenSSL::PKey::RSA.new(key_pem).sign(OpenSSL::Digest.new('SHA1'), signing_data)
		when 'rsa-sha256'
			sig = OpenSSL::PKey::RSA.new(key_pem).sign(OpenSSL::Digest.new('SHA256'), signing_data)
		when 'ed25519-sha256'
			# RFC 8463 Section 3: "signs the hash with PureEdDSA" — "the hash" is SHA256(signing_data),
			# consistent with RSA-SHA256 which also signs SHA256(signing_data) via PKCS#1.
			sig = OpenSSL::PKey.read(key_pem).sign(nil, OpenSSL::Digest::SHA256.digest(signing_data))
		else
			sig = abort "preprocess: unsupported DKIM algorithm: #{algo}"
		end

		value.gsub!(/\bb=[^;]*/, fold_b64(Base64.strict_encode64(sig)))
	}

	head_text = headers.map { |n, v| "#{n}:#{v}" }.join("\r\n")
	"#{head_text}\r\n\r\n#{body}"
end

content = sign_dkim(content, options.dkim_key, force: options.force)
# }}}

if content.match?(/INSERT-\w+-VARIABLE/)
	msg = "preprocess: unresolved placeholder: #{content.match(/INSERT-\w+-VARIABLE/)[0]}"
	options.force ? warn(msg) : abort(msg)
end

if output_file
	File.write(output_file, content)
else
	print content
end
